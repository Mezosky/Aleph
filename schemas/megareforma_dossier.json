{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mezosky.github.io/Aleph/schemas/megareforma_dossier.json",
  "title": "Frozen Megareforma dossier",
  "type": "object",
  "required": ["schema_version", "generated_at", "retrieval_cutoff", "data_status", "document", "model", "summary", "objectives", "meters", "debate", "other_angles", "actors", "counts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "retrieval_cutoff": {"type": "string", "format": "date-time"},
    "data_status": {"const": "real_frozen_snapshot"},
    "document": {
      "type": "object",
      "required": ["id", "title", "source_url", "pdf_url", "date", "page_count", "sha256", "scope_note"],
      "properties": {
        "id": {"const": "18216-05"},
        "title": {"type": "string", "minLength": 20},
        "short_title": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "pdf_url": {"type": "string", "format": "uri"},
        "date": {"type": "string", "format": "date"},
        "page_count": {"const": 46},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope_note": {"type": "string", "minLength": 80}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["name", "revision", "execution", "runtime_calls"],
      "properties": {
        "name": {"type": "string"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "execution": {"const": "local_gpu_offline"},
        "runtime_calls": {"const": 0}
      },
      "additionalProperties": false
    },
    "summary": {"type": "string", "minLength": 80},
    "objectives": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "plain_language", "mechanism", "affected_groups", "source_quote", "page", "caveat", "quote_verified"],
        "properties": {
          "id": {"type": "string"},
          "category": {"type": "string"},
          "title": {"type": "string", "minLength": 5},
          "plain_language": {"type": "string", "minLength": 20},
          "mechanism": {"type": "string", "minLength": 20},
          "affected_groups": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_quote": {"type": "string", "minLength": 12},
          "page": {"type": "integer", "minimum": 1, "maximum": 46},
          "caveat": {"type": "string", "minLength": 10},
          "quote_verified": {"const": true},
          "quote_grounding_method": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "meters": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "question", "left_label", "center_label", "right_label", "value", "confidence", "explanation", "methodology", "evidence", "actor_ids", "pole_actor_ids"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["editorial_tone", "policy_tradeoff", "public_interest"]},
          "title": {"type": "string"},
          "question": {"type": "string"},
          "left_label": {"type": "string"},
          "center_label": {"type": "string"},
          "right_label": {"type": "string"},
          "value": {"type": "number", "minimum": 0, "maximum": 100},
          "confidence": {"enum": ["low", "medium", "high"]},
          "explanation": {"type": "string", "minLength": 30},
          "methodology": {"type": "string", "minLength": 30},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "value", "source_ids"], "properties": {"label": {"type": "string"}, "value": {"type": "number"}, "source_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
          "actor_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "pole_actor_ids": {"type": "object", "required": ["left", "right"], "properties": {"left": {"type": "array", "items": {"type": "string"}}, "right": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
        },
        "additionalProperties": false
      }
    },
    "debate": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["news_source_ids"],
        "properties": {
          "news_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "other_angles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "question", "finding", "why_it_matters", "limitation", "source_ids", "actor_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 10},
          "question": {"type": "string", "minLength": 20},
          "finding": {"type": "string", "minLength": 80},
          "why_it_matters": {"type": "string", "minLength": 40},
          "limitation": {"type": "string", "minLength": 40},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "actor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "actors": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "institution", "affiliation", "position_summary", "image", "image_alt", "image_credit", "image_license", "image_source_url", "roles", "legal_record", "official_record_audit", "public_record", "record_caveat", "sources"],
        "properties": {
          "id": {"type": "string"}, "name": {"type": "string"}, "role": {"type": "string"}, "institution": {"type": "string"}, "affiliation": {"type": "string"}, "position_summary": {"type": "string"}, "image": {"type": "string"}, "image_alt": {"type": "string"}, "image_credit": {"type": "string"}, "image_license": {"type": "string"}, "image_source_url": {"type": "string", "format": "uri"}, "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "legal_record": {"type": "array", "items": {"$ref": "#/$defs/legal_record_entry"}}, "official_case_context": {"type": "array", "items": {"$ref": "#/$defs/official_case_context_entry"}}, "official_record_audit": {"$ref": "#/$defs/official_record_audit"}, "public_record": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["date", "action", "outcome", "assessment", "status", "source_ids"], "properties": {"date": {"type": "string"}, "action": {"type": "string"}, "outcome": {"type": "string"}, "assessment": {"type": "string"}, "status": {"enum": ["observed", "pending", "not_testable"]}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}}, "record_caveat": {"type": "string", "minLength": 60}, "sources": {"type": "array", "minItems": 2}
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": ["propositions", "sources_curated", "sources_captured", "capture_gaps", "model_runs_completed"],
      "properties": {
        "propositions": {"type": "integer", "minimum": 1}, "sources_curated": {"type": "integer", "minimum": 1}, "sources_captured": {"type": "integer", "minimum": 0}, "capture_gaps": {"type": "integer", "minimum": 0}, "model_runs_completed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "official_record_audit": {
      "type": "object",
      "required": ["status", "checked_at", "repositories", "caveat"],
      "properties": {
        "status": {"enum": ["no_qualifying_record_documented", "personal_record_attached", "professional_context_attached", "personal_record_and_professional_context_attached"]},
        "checked_at": {"type": "string", "format": "date"},
        "repositories": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "caveat": {"type": "string", "minLength": 60}
      },
      "additionalProperties": false
    },
    "official_case_context_entry": {
      "type": "object",
      "description": "A primary official decision that names the actor in a professional role but does not sanction that actor personally. It must not be represented as a personal legal record.",
      "required": ["case_title", "case_number", "date", "role", "summary", "outcome", "personal_status", "relevance_to_document", "caveat", "source"],
      "properties": {
        "case_title": {"type": "string", "minLength": 10},
        "case_number": {"type": "string", "minLength": 3},
        "date": {"type": "string", "format": "date"},
        "role": {"type": "string", "minLength": 20},
        "summary": {"type": "string", "minLength": 80},
        "outcome": {"type": "string", "minLength": 40},
        "personal_status": {"const": "named_professional_not_sanctioned"},
        "relevance_to_document": {"type": "string", "minLength": 60},
        "caveat": {"type": "string", "minLength": 60},
        "source": {
          "type": "object",
          "required": ["id", "title", "url", "publisher", "published_at", "tier"],
          "properties": {
            "id": {"type": "string"},
            "title": {"type": "string"},
            "url": {"type": "string", "format": "uri"},
            "publisher": {"type": "string"},
            "published_at": {"type": ["string", "null"], "format": "date"},
            "tier": {"const": "primary_document"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "legal_record_entry": {
      "type": "object",
      "description": "Primary official legal record. It supplies context only and must never influence a claim verdict.",
      "required": ["summary", "status", "resolved", "body", "date", "presumption_note", "source"],
      "properties": {
        "summary": {"type": "string", "minLength": 40},
        "status": {"enum": ["investigation_reported", "formally_investigated", "charged", "trial_ongoing", "convicted", "acquitted", "dismissed", "case_closed", "administrative_sanction", "sanction_overturned", "unknown"]},
        "resolved": {"type": "boolean"},
        "body": {"type": "string", "minLength": 5},
        "date": {"type": ["string", "null"], "format": "date"},
        "presumption_note": {"type": ["string", "null"]},
        "source": {
          "type": "object",
          "required": ["id", "title", "url", "publisher", "published_at", "tier"],
          "properties": {
            "id": {"type": "string"},
            "title": {"type": "string"},
            "url": {"type": "string", "format": "uri"},
            "publisher": {"type": "string"},
            "published_at": {"type": ["string", "null"], "format": "date"},
            "tier": {"enum": ["primary_document", "legislative_record", "official_technical_report"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"resolved": {"const": false}}, "required": ["resolved"]},
          "then": {
            "properties": {
              "status": {"enum": ["investigation_reported", "formally_investigated", "charged", "trial_ongoing", "administrative_sanction", "unknown"]},
              "presumption_note": {"type": "string", "minLength": 30}
            }
          }
        },
        {
          "if": {"properties": {"resolved": {"const": true}}, "required": ["resolved"]},
          "then": {
            "properties": {
              "status": {"enum": ["convicted", "acquitted", "dismissed", "case_closed", "sanction_overturned"]},
              "presumption_note": {"type": "null"}
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
