{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mezosky.github.io/Aleph/schemas/megareforma_deep_analysis.json",
  "title": "Full-document Megareforma topic audit",
  "type": "object",
  "required": ["schema_version", "generated_at", "execution", "runtime_calls", "document", "coverage", "topics", "model"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "execution": {"const": "local_gpu_offline"},
    "runtime_calls": {"const": 0},
    "document": {
      "type": "object",
      "required": ["id", "sha256", "pages", "paragraphs", "propositions", "last_structured_page"],
      "properties": {
        "id": {"const": "18216-05"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pages": {"const": 46},
        "paragraphs": {"type": "integer", "minimum": 500},
        "propositions": {"type": "integer", "minimum": 700},
        "last_structured_page": {"const": 46}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["topics_declared", "topics_grounded", "topics_with_captured_news", "topics_without_captured_news", "pages_structured", "page_coverage_percent", "blank_pages", "reviewed_model_fields", "review_method", "methodology", "limitation"],
      "properties": {
        "topics_declared": {"const": 30},
        "topics_grounded": {"const": 30},
        "topics_with_captured_news": {"type": "integer", "minimum": 0, "maximum": 30},
        "topics_without_captured_news": {"type": "integer", "minimum": 0, "maximum": 30},
        "pages_structured": {"const": 46},
        "page_coverage_percent": {"const": 100},
        "blank_pages": {"const": [43]},
        "reviewed_model_fields": {"type": "integer", "minimum": 1},
        "review_method": {"type": "string", "minLength": 80},
        "methodology": {"type": "string", "minLength": 100},
        "limitation": {"type": "string", "minLength": 80}
      },
      "additionalProperties": false
    },
    "topics": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "title", "group", "pages", "what_changes", "mechanism", "government_goal", "affected_groups", "fiscal_effect", "assumptions", "risks_and_open_questions", "source_quote", "source_page", "quote_verified", "news_source_ids", "coverage_status"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "group": {"enum": ["gasto_y_reconstruccion", "educacion", "empleo_publico", "regulacion", "tributos_permanentes", "tributos_transitorios", "efecto_fiscal"]},
          "pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 46}},
          "what_changes": {"type": "string", "minLength": 30},
          "mechanism": {"type": "string", "minLength": 30},
          "government_goal": {"type": "string", "minLength": 20},
          "affected_groups": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fiscal_effect": {"type": "string", "minLength": 20},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "risks_and_open_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_quote": {"type": "string", "minLength": 15},
          "source_page": {"type": "integer", "minimum": 1, "maximum": 46},
          "quote_verified": {"const": true}
          ,"news_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          ,"coverage_status": {"enum": ["captured_news", "no_captured_news"]}
        },
        "additionalProperties": false
      }
    },
    "model": {
      "type": "object",
      "required": ["name", "revision", "batches", "usage"],
      "properties": {
        "name": {"type": "string"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "batches": {"type": "integer", "minimum": 1},
        "usage": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
