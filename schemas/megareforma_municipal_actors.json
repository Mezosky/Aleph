{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mezosky.github.io/Aleph/schemas/megareforma_municipal_actors.json",
  "title": "Audited municipal actor index for the Megareforma dossier",
  "type": "object",
  "required": ["schema_version", "document_id", "retrieval_cutoff", "coverage", "actors"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_id": {"const": "18216-05"},
    "retrieval_cutoff": {"type": "string", "format": "date-time"},
    "coverage": {
      "type": "object",
      "required": ["universe", "method", "municipal_sources_curated", "actors_indexed", "blind_path_rule", "limitation"],
      "properties": {
        "universe": {"type": "string", "minLength": 40},
        "method": {"type": "string", "minLength": 80},
        "municipal_sources_curated": {"type": "integer", "minimum": 1},
        "actors_indexed": {"type": "integer", "minimum": 10},
        "blind_path_rule": {"type": "string", "minLength": 50},
        "limitation": {"type": "string", "minLength": 60}
      },
      "additionalProperties": false
    },
    "actors": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name", "municipality", "role", "affiliation", "position_group", "position_summary", "public_record", "source_ids", "record_caveat"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 3},
          "municipality": {"type": "string", "minLength": 2},
          "role": {"type": "string", "minLength": 5},
          "affiliation": {"type": "string", "minLength": 2},
          "position_group": {"enum": ["government_formula", "targeted_exemption", "revenue_protection", "dialogue_participant"]},
          "position_summary": {"type": "string", "minLength": 30},
          "image": {"type": "string"},
          "image_alt": {"type": "string"},
          "image_credit": {"type": "string"},
          "image_license": {"type": "string"},
          "image_source_url": {"type": "string", "format": "uri"},
          "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "public_record": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["date", "action", "outcome", "assessment", "status", "source_ids"],
              "properties": {
                "date": {"type": "string", "format": "date"},
                "action": {"type": "string", "minLength": 20},
                "outcome": {"type": "string", "minLength": 20},
                "assessment": {"type": "string", "minLength": 30},
                "status": {"enum": ["observed", "pending", "not_testable"]},
                "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "record_caveat": {"type": "string", "minLength": 60}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
