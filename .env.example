# ---------------------------------------------------------------------------
# Aleph — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file must only ever
# contain placeholders.
#
#   cp .env.example .env
#
# Aleph runs end to end with NO credentials: leave ALEPH_LLM_PROVIDER=mock and
# the deterministic mock provider supplies every model response.
# ---------------------------------------------------------------------------


# === Runtime =================================================================

# Deployment context. Affects logging verbosity and error detail only; it never
# changes analytical behaviour.
# One of: development | production | test
ALEPH_ENV=development

# Log level for the library and the API.
# One of: debug | info | warning | error
ALEPH_LOG_LEVEL=info

# Fixed seed for every stochastic step (sampling, tie-breaking, shuffles). Aleph
# is meant to be reproducible: the same document must yield the same bundle.
ALEPH_SEED=20260807


# === Filesystem ==============================================================

# Root for working data: raw/ (downloads), processed/ (intermediates),
# exports/ (finished bundles). Inside containers this is /app/data.
ALEPH_DATA_DIR=./data

# Directory holding the JSON Schema contract. Served by GET /v1/schemas/{name}.
ALEPH_SCHEMA_DIR=./schemas

# Where the static export writes the site payload. This directory IS committed —
# it is what GitHub Pages serves.
ALEPH_STATIC_OUT_DIR=./frontend/public/data

# Registry of news sources and jurisdiction-specific configuration. All
# jurisdiction detail lives in data/registry files, never in library code.
ALEPH_SOURCE_REGISTRY=./data/registry/sources.yaml


# === Language model provider =================================================

# Which LLMProvider implementation to load.
#   mock  - deterministic, offline, no credentials. Default and CI default.
#   qwen  - OpenAI-compatible HTTP endpoint serving a Qwen model.
ALEPH_LLM_PROVIDER=mock

# Base URL of the OpenAI-compatible endpoint (include the /v1 suffix if the
# server expects it). Ignored when ALEPH_LLM_PROVIDER=mock.
# Example: https://your-inference-host.example.com/v1
ALEPH_QWEN_BASE_URL=

# API key for that endpoint. SECRET — never commit a real value, never expose it
# through an API response, never pass it to the frontend build.
ALEPH_QWEN_API_KEY=replace-me

# Model identifier requested from the local vLLM endpoint. The recommended
# checkpoint is quantized for this machine's Blackwell GPU.
ALEPH_QWEN_MODEL=nvidia/Qwen3.5-122B-A10B-NVFP4

# Immutable checkpoint revision. Do not use "main" for published analyses.
ALEPH_QWEN_REVISION=98915d837c4e7c87ac8296d02e89de19b3207e6d

# Sampling temperature. Kept at 0 so runs are reproducible and two analyses of
# the same text can be meaningfully diffed.
ALEPH_LLM_TEMPERATURE=0.0

# Per-request timeout, in seconds.
ALEPH_LLM_TIMEOUT_SECONDS=120

# Retries on transient (5xx / timeout) failures before the phase is marked failed.
ALEPH_LLM_MAX_RETRIES=3


# === Evidence retrieval ======================================================

# Search backend used to collect candidate evidence.
#   none    - retrieval disabled; only the primary document is analysed.
#   mock    - deterministic fixture results, offline.
#   http    - live provider configured by the two settings below.
ALEPH_SEARCH_PROVIDER=mock

# Endpoint for the live search provider. Ignored unless provider=http.
ALEPH_SEARCH_BASE_URL=

# API key for the live search provider. SECRET.
ALEPH_SEARCH_API_KEY=

# Maximum candidate documents fetched per generated query term.
ALEPH_SEARCH_MAX_RESULTS=20


# === Outbound HTTP ===========================================================

# User-Agent sent when fetching documents and articles. Identify the crawler
# honestly and give operators a way to reach you.
ALEPH_HTTP_USER_AGENT=Aleph/0.1 (+https://github.com/Mezosky/Aleph)

# Timeout for document/article fetches, in seconds.
ALEPH_FETCH_TIMEOUT_SECONDS=30

# Minimum delay between requests to the same host, in seconds. Politeness, not
# performance.
ALEPH_FETCH_DELAY_SECONDS=1.0


# === API server ==============================================================

ALEPH_API_HOST=0.0.0.0
ALEPH_API_PORT=8000

# Comma-separated list of browser origins permitted to call the API.
# Use explicit origins. Do not use "*" with credentials.
ALEPH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest accepted upload for POST /v1/analyses, in megabytes.
ALEPH_MAX_UPLOAD_MB=50

# Concurrent analysis jobs the in-process store will run.
ALEPH_MAX_CONCURRENT_JOBS=2


# === Durable database =======================================================

# Local fallback (single process): sqlite:///./data/aleph.db
# Docker/production: postgresql+psycopg://aleph:password@postgres:5432/aleph
# Treat this as a secret because PostgreSQL URLs contain credentials.
ALEPH_DATABASE_URL=sqlite:///./data/aleph.db

# Local convenience. The production container also executes Alembic migrations.
ALEPH_DATABASE_AUTO_CREATE=true

# Docker-only PostgreSQL settings. Change the password outside local development.
ALEPH_POSTGRES_DB=aleph
ALEPH_POSTGRES_USER=aleph
ALEPH_POSTGRES_PASSWORD=aleph-local-only

# After the pinned Qwen checkpoint has downloaded successfully, set this to 1
# so the inference container cannot contact Hugging Face on later launches.
HF_HUB_OFFLINE=0


# ---------------------------------------------------------------------------
# === Frontend build variables ==============================================
#
# !! SECURITY !! Every VITE_* variable is INLINED INTO THE PUBLIC JAVASCRIPT
# BUNDLE at build time. Anyone who loads the site can read its value. NEVER put
# an API key, token, or any other secret in a VITE_* variable. If the browser
# must not know it, it does not belong here.
# ---------------------------------------------------------------------------

# Public base path the site is served from. "/" for local/container serving;
# "/Aleph/" for the GitHub Pages deployment at https://mezosky.github.io/Aleph/.
VITE_BASE=/

# Public URL of the Aleph API. Leave EMPTY to build a fully static site that
# reads the committed JSON under frontend/public/data/ instead of calling an API.
VITE_ALEPH_API_URL=http://localhost:8000
